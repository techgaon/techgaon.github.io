    // TechGaon website requests: visitors may submit; only the dedicated admin can read.
    match /techgaonEnquiries/{id} {
      function enquiryAdmin() { return request.auth != null && request.auth.uid == 'ADMIN_FIREBASE_UID'; }
      allow create: if request.resource.data.keys().hasAll(['name','phone','email','kind','message','budget','timeline','status','createdAt'])
        && request.resource.data.keys().hasOnly(['name','phone','email','kind','message','budget','timeline','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email is string && request.resource.data.email.size() <= 180
        && request.resource.data.kind in ['school','shop','institution','amc','app','other']
        && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
        && request.resource.data.budget is string && request.resource.data.budget.size() <= 100
        && request.resource.data.timeline is string && request.resource.data.timeline.size() <= 100
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time + duration.value(5,'m')
        && request.resource.data.createdAt >= request.time - duration.value(5,'m');
      allow read: if enquiryAdmin();
      allow update: if enquiryAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','notes'])
        && request.resource.data.status in ['new','contacted','quoted','agreed','in_progress','completed','closed']
        && request.resource.data.get('notes','') is string && request.resource.data.get('notes','').size() <= 4000;
      allow delete: if false;
    }
